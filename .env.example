# Original Red Alert 2 MIX files. Resources and credentials stay local.
MIX_DIR=./assets/ra2
# Optional completed local match for the homepage replay button.
# WATCH_MATCH=runs/<run-directory>/result.json
# Pin the maintained player build; an experimental build can be served separately.
# PLAYER_RELEASE=<player bundle SHA-256>
# PLAYER_CHALLENGER=<challenger player bundle SHA-256>
# Only needed for the official online Bot API route.
# XWOL_API_KEY=
# XWOL_API_URL=
# CLIENT_URL=
