{
  "name": "warbook-ai",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "match": "node --env-file-if-exists=.env --import ./src/engine-diagnostics.mjs --import tsx src/runner.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "tsc",
    "player:build": "node --import tsx scripts/build-player.ts",
    "replay": "node --env-file-if-exists=.env --import tsx scripts/replay.ts",
    "batch": "node --import tsx scripts/batch.ts",
    "play": "npm run player:build && node --env-file-if-exists=.env --import tsx src/player/server.ts",
    "bot:build": "node --import tsx scripts/build-bot.ts",
    "analyze": "python3 analysis/compare_runs.py",
    "analyze:encounter": "node --env-file-if-exists=.env --import tsx scripts/encounter.ts",
    "test:analysis": "python3 -m unittest discover -s analysis -p 'test_*.py'",
    "experiment:matrix": "node --import tsx scripts/matrix.ts"
  },
  "dependencies": {
    "@chronodivide/game-api": "0.79.0",
    "@hono/node-server": "2.1.1",
    "hono": "4.13.7",
    "ngraph.graph": "20.1.2",
    "ngraph.path": "1.6.1",
    "three": "0.94.0"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.20",
    "@supalosa/chronodivide-bot": "0.6.8-beta.3-165b77a",
    "@types/node": "26.5.1",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@supalosa/chronodivide-bot": {
      "@chronodivide/game-api": "$@chronodivide/game-api"
    }
  }
}
